@model Microplex.Web.Data.Client
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Edit Client"; }
<section class="dashboard-heading"><div><span class="page-kicker">CLIENT MANAGEMENT</span><h1>Edit client.</h1><p>Update company details or enable additional services.</p></div><a class="report-link" asp-action="Index">Back to client report <span>→</span></a></section>
<form asp-action="Edit" asp-route-id="@Model.ClientId" method="post" class="client-form"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="form-section"><div class="form-section-heading"><span>01</span><div><h2>Company information</h2><p>Permanent client ID: <code>@Model.ClientId</code></p></div></div><div class="row g-4"><div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control admin-input" /><span asp-validation-for="CompanyName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control admin-input" /><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control admin-input" rows="3"></textarea><span asp-validation-for="Address" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Mobile" class="form-label"></label><input asp-for="Mobile" class="form-control admin-input" /><div class="form-hint">International format is mandatory.</div><span asp-validation-for="Mobile" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Website" class="form-label"></label><input asp-for="Website" class="form-control admin-input" /><span asp-validation-for="Website" class="text-danger small"></span></div></div></div><div class="form-section"><div class="form-section-heading"><span>02</span><div><h2>Features using</h2><p>Enable or disable services without changing the client ID.</p></div></div><div class="feature-options"><label class="feature-option"><input asp-for="UsesSoftwareSolution" /><span class="feature-check">✓</span><span><strong>Software Solution</strong><small>ERP, POS and business applications</small></span></label><label class="feature-option"><input asp-for="UsesEmailSolution" /><span class="feature-check">✓</span><span><strong>Email Solution</strong><small>Business email services</small></span></label><label class="feature-option"><input asp-for="UsesSmsSolution" /><span class="feature-check">✓</span><span><strong>SMS Solution</strong><small>Messaging and notification services</small></span></label></div></div><div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-admin-primary submit-client">Save changes <span>→</span></button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
