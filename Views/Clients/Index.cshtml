@model IReadOnlyList<Microplex.Web.Data.Client>
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Client Info Report"; var search = ViewData["Search"]?.ToString(); }
<section class="dashboard-heading"><div><span class="page-kicker">CLIENT MANAGEMENT</span><h1>Client info report.</h1><p>Review all registered client information and enabled services.</p></div><a class="btn btn-admin-primary add-client-button" asp-action="Create">+ Register client</a></section>
@if (TempData["Success"] is string successMessage) { <div class="alert success-alert" role="status"><span>✓</span>@successMessage</div> }
<section class="dashboard-card report-card"><div class="report-toolbar"><form method="get" class="report-search"><span>⌕</span><input type="search" name="search" value="@search" placeholder="Search company, email, mobile or address" aria-label="Search clients" /><button type="submit">Search</button>@if (!string.IsNullOrWhiteSpace(search)) { <a asp-action="Index">Clear</a> }</form><span class="record-count">@Model.Count record@(Model.Count == 1 ? "" : "s")</span></div>@if (Model.Count == 0) { <div class="report-empty"><span>▣</span><h2>No clients found</h2><p>@(string.IsNullOrWhiteSpace(search) ? "Register your first client to begin building the report." : "Try a different search term.")</p><a asp-action="Create" class="btn btn-admin-primary">Register client <span>→</span></a></div> } else { <div class="client-report-list">@foreach (var client in Model) { <article class="client-report-row"><div class="client-id-block"><span class="company-letter">@client.CompanyName[0].ToString().ToUpperInvariant()</span><div><h2>@client.CompanyName</h2><code title="Permanent client identifier">@client.ClientId</code></div></div><div class="contact-block"><span>CONTACT</span><a href="mailto:@client.Email">@client.Email</a><a href="tel:@client.Mobile">@client.Mobile</a></div><div class="address-block"><span>ADDRESS</span><p>@client.Address</p>@if (!string.IsNullOrWhiteSpace(client.Website)) { <a href="@client.Website" target="_blank" rel="noopener">Visit website ↗</a> }</div><div class="features-block"><span>FEATURES USING</span><div>@if (client.UsesSoftwareSolution) { <b class="feature-pill software">Software</b> }@if (client.UsesEmailSolution) { <b class="feature-pill email">Email</b> }@if (client.UsesSmsSolution) { <b class="feature-pill sms">SMS</b> }@if (!client.UsesSoftwareSolution && !client.UsesEmailSolution && !client.UsesSmsSolution) { <em>None enabled</em> }</div><a class="edit-client-link" asp-action="Edit" asp-route-id="@client.ClientId">Edit client →</a></div></article> }</div> }</section>
