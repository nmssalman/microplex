@model Microplex.Web.Models.DashboardViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<Microplex.Web.Data.ApplicationUser> UserManager
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Dashboard"; var dashboardUser = await UserManager.GetUserAsync(User); var avatarColors = new[] { "blue", "purple", "green" }; }
<section class="dashboard-heading"><div><span class="page-kicker">SUPER ADMIN WORKSPACE</span><h1>Good day, @((dashboardUser?.FullName ?? "Administrator").Split(' ')[0]).</h1><p>Here’s a clear view of your business workspace.</p></div><div class="heading-date"><span>TODAY</span><strong>@DateTime.Now.ToString("dd MMM yyyy")</strong></div></section>
<section class="metric-grid" aria-label="Business overview"><article class="metric-card metric-blue"><div class="metric-icon">◫</div><span>TOTAL CLIENTS</span><strong>@Model.TotalClients</strong><small><i></i> Active relationships</small></article><article class="metric-card metric-violet"><div class="metric-icon">◇</div><span>SOLUTION AREAS</span><strong>6</strong><small>ERP, POS, AI and more</small></article><article class="metric-card metric-cyan"><div class="metric-icon">◎</div><span>OFFICE LOCATIONS</span><strong>2</strong><small>Sri Lanka · Japan</small></article><article class="metric-card metric-coral"><div class="metric-icon">↗</div><span>OPEN ITEMS</span><strong>—</strong><small>Ready for your data</small></article></section>
<div class="row g-4"><div class="col-xl-8"><section class="dashboard-card"><div class="card-heading"><div><span class="page-kicker">CLIENT PORTFOLIO</span><h2>Current clients</h2></div><a class="soft-button" asp-controller="Clients" asp-action="Index">View all</a></div><div class="client-table-wrap"><table class="table client-table align-middle mb-0"><thead><tr><th>Client</th><th>Contact</th><th>Address</th><th>Status</th></tr></thead><tbody>@if (!Model.RecentClients.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">No clients registered yet.</td></tr> } else { for (var i = 0; i < Model.RecentClients.Count; i++) { var client = Model.RecentClients[i]; var initials = string.Concat(client.CompanyName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0]))); <tr><td><span class="table-avatar @avatarColors[i % avatarColors.Length]">@initials</span><strong>@client.CompanyName</strong></td><td><a href="mailto:@client.Email">@client.Email</a></td><td>@client.Address</td><td><span class="status-pill">Active</span></td></tr> } }</tbody></table></div></section></div><div class="col-xl-4"><section class="dashboard-card h-100"><div class="card-heading"><div><span class="page-kicker">QUICK VIEW</span><h2>Company reach</h2></div></div><div class="reach-item"><span class="flag-box">LK</span><div><strong>Head Office</strong><small>Anuradhapura, Sri Lanka</small></div></div><div class="reach-item"><span class="flag-box japan">JP</span><div><strong>Branch Office</strong><small>Atsugi, Kanagawa, Japan</small></div></div><div class="dashboard-empty"><span>+</span><p>More dashboard details can be added when provided.</p></div></section></div></div>
