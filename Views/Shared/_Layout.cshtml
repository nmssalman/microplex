<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Microplex Corporation builds ERP, POS, digital advertising, financial, AI and machine learning software solutions." />
    <title>@ViewData["Title"] | Microplex Corporation</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/clients.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Microplex.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index" aria-label="Microplex Corporation home"><span class="brand-mark" aria-hidden="true">M</span><span>MICROPLEX</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About Us</a>
                        </li><li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Solutions" ? "active" : "")" asp-controller="Home" asp-action="Solutions">Solutions</a>
                        </li><li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Academy" ? "active" : "")" asp-controller="Home" asp-action="Academy">Academy</a>
                        </li><li class="nav-item ms-lg-2">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li><li class="nav-item ms-lg-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a class="btn btn-primary btn-sm px-4" asp-controller="Dashboard" asp-action="Index">Dashboard <span aria-hidden="true">→</span></a>
                            }
                            else
                            {
                                <a class="btn btn-primary btn-sm px-4" asp-controller="Account" asp-action="Login">Admin Login <span aria-hidden="true">→</span></a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">@RenderBody()</main>

    <footer class="site-footer">
        <div class="container">
            <div class="row align-items-center gy-3"><div class="col-md-6"><strong>MICROPLEX</strong><span class="footer-divider"></span>Technology without limits.</div><div class="col-md-6 text-md-end"><a asp-controller="Status" asp-action="Index" class="footer-link">System Status</a><span class="footer-divider"></span><a asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy Policy</a><span class="footer-divider"></span>&copy; @Microplex.Web.Utilities.SriLankaTime.Now.Year Microplex Corporation. All rights reserved.</div></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
