@model LoginViewModel
@{ Layout = null; ViewData["Title"] = "Administrator Login"; }
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Administrator Login | Microplex</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /></head>
<body class="login-page"><main class="login-shell"><section class="login-brand-panel"><a class="admin-brand text-white" asp-controller="Home" asp-action="Index"><span class="admin-brand-mark">M</span><span>MICROPLEX<small>Business Suite</small></span></a><div class="login-message"><span class="login-kicker">BUSINESS, CONNECTED.</span><h1>Welcome back to your command center.</h1><p>Manage operations, monitor performance, and keep every part of your business moving from one secure workspace.</p></div><div class="login-grid" aria-hidden="true"></div><p class="login-copyright">© @Microplex.Web.Utilities.SriLankaTime.Now.Year Microplex Corporation</p></section><section class="login-form-panel"><div class="login-form-wrap"><div class="mobile-login-brand"><span class="admin-brand-mark">M</span><strong>MICROPLEX</strong></div><span class="form-kicker">SECURE ADMIN ACCESS</span><h2>Sign in</h2><p class="form-intro">Enter your administrator credentials to continue.</p><form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate><div asp-validation-summary="ModelOnly" class="alert alert-danger login-alert" role="alert"></div><div class="mb-4"><label asp-for="Username" class="form-label"></label><div class="input-shell"><span aria-hidden="true">@@</span><input asp-for="Username" class="form-control" autocomplete="username" placeholder="admin@microplex.lk" autofocus /></div><span asp-validation-for="Username" class="text-danger small"></span></div><div class="mb-3"><div class="d-flex justify-content-between"><label asp-for="Password" class="form-label"></label><span class="secure-label">ENCRYPTED</span></div><div class="input-shell"><span aria-hidden="true">●</span><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Enter your password" /></div><span asp-validation-for="Password" class="text-danger small"></span></div><div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div><button class="btn btn-admin-primary w-100" type="submit">Sign in to dashboard <span>→</span></button></form><div class="login-support"><span></span><p>Need access? Contact your system administrator.</p><span></span></div><a class="back-site" asp-controller="Home" asp-action="Index">← Return to company website</a></div></section></main><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script></body></html>
