@{
    ViewData["Title"] = "Software Solutions for a Connected World";
}
<div class="home-jp">
  <section class="jp-hero">
    <div class="jp-sun" aria-hidden="true"><span class="jp-sun-ray r3"></span><span class="jp-sun-ray r2"></span><span class="jp-sun-ray r1"></span><span class="jp-sun-core"></span></div>
    <div class="container position-relative">
      <div class="row align-items-center gy-4">
        <div class="col-lg-7">
          <span class="jp-eyebrow reveal" style="--d:0s">BUILT IN SRI LANKA &middot; CONNECTED TO JAPAN</span>
          <h1 class="jp-title reveal" style="--d:.08s">Software, crafted<br /><span>with precision.</span></h1>
          <p class="jp-copy reveal" style="--d:.16s">Microplex engineers dependable ERP, POS, fintech and AI systems &mdash; built with Sri Lankan craftsmanship, refined by Japanese discipline.</p>
          <div class="jp-cta-row reveal" style="--d:.24s"><a class="jp-btn jp-btn-primary" asp-action="Contact">Start a conversation <span aria-hidden="true">&rarr;</span></a><a class="jp-btn jp-btn-ghost" asp-action="About">Discover Microplex</a></div>
        </div>
        <div class="col-lg-5 d-none d-lg-block">
          <div class="jp-mon reveal" style="--d:.12s"><span>M</span><small>MICROPLEX</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="jp-strip">
    <div class="container">
      <div class="jp-strip-head"><span class="jp-kicker">WHAT WE ENGINEER</span><span class="jp-thread" aria-hidden="true"></span></div>
      <div class="row g-3">
        <div class="col-6 col-lg-3"><article class="jp-card reveal" style="--d:.04s"><span class="jp-card-no">01</span><h3>Business Systems</h3><p>ERP &amp; POS platforms built around your teams.</p></article></div>
        <div class="col-6 col-lg-3"><article class="jp-card reveal" style="--d:.08s"><span class="jp-card-no">02</span><h3>Digital Experiences</h3><p>Advertising &amp; content across every screen.</p></article></div>
        <div class="col-6 col-lg-3"><article class="jp-card reveal" style="--d:.12s"><span class="jp-card-no">03</span><h3>Financial Technology</h3><p>Secure software for financial operations.</p></article></div>
        <div class="col-6 col-lg-3"><article class="jp-card reveal" style="--d:.16s"><span class="jp-card-no">04</span><h3>Applied Intelligence</h3><p>AI &amp; ML focused on measurable outcomes.</p></article></div>
      </div>
    </div>
  </section>

  <section class="jp-strip jp-strip-alt">
    <div class="container">
      <div class="jp-strip-head"><span class="jp-kicker">TRUSTED BY</span><span class="jp-thread" aria-hidden="true"></span></div>
      <div class="row g-3">
        <div class="col-md-4"><article class="jp-client reveal" style="--d:.04s"><span class="jp-client-mono">D</span><div><h3>Denims</h3><small>Clothing store &middot; Anuradhapura</small></div></article></div>
        <div class="col-md-4"><article class="jp-client reveal" style="--d:.08s"><span class="jp-client-mono">MM</span><div><h3>M. M. Pawning Pvt Ltd</h3><small>Gold pawning &middot; 5 branches</small></div></article></div>
        <div class="col-md-4"><article class="jp-client reveal" style="--d:.12s"><span class="jp-client-mono">KI</span><div><h3>Kumarasingha Industries</h3><small>Battery terminal factory</small></div></article></div>
      </div>
    </div>
  </section>

  <section class="jp-cta">
    <div class="container jp-cta-row-wrap">
      <div><span class="jp-kicker jp-kicker-light">YOUR NEXT SYSTEM STARTS HERE</span><h2>Let&rsquo;s build something that works brilliantly.</h2></div>
      <a class="jp-btn jp-btn-light" asp-action="Contact">Contact Microplex <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
</div>
@section Scripts {
<script>
    (function () {
        var els = document.querySelectorAll(".home-jp .reveal");
        if (!("IntersectionObserver" in window)) { els.forEach(function (el) { el.classList.add("in"); }); return; }
        var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) { entry.target.classList.add("in"); obs.unobserve(entry.target); }
            });
        }, { threshold: 0.15 });
        els.forEach(function (el) { obs.observe(el); });
    })();
</script>
}
