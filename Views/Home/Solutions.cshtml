@{ ViewData["Title"] = "Solutions"; }
<section class="page-hero solutions-hero"><div class="container"><span class="eyebrow">SOLUTIONS</span><h1>Two gateways.<br />Every message that matters.</h1><p>Beyond ERP, POS, and digital advertising, Microplex operates dedicated messaging gateways so your systems can reach customers reliably&mdash;by SMS or email.</p></div></section>
@if (TempData["InquirySuccess"] is string inquirySuccess) { <div class="container mt-5"><div class="alert alert-success" role="status">@inquirySuccess</div></div> }
@if (TempData["InquiryError"] is string inquiryError) { <div class="container mt-5"><div class="alert alert-danger" role="alert">@inquiryError</div></div> }

<section class="section-space"><div class="container"><div class="sms-panel"><div class="row align-items-center g-5"><div class="col-lg-6"><span class="section-kicker">SMS GATEWAY</span><h2>Every message,<br />delivered instantly.</h2><p>Send transactional and marketing SMS at scale through our reliable gateway&mdash;complete with your own custom Sender ID, real-time balance tracking, and a simple REST API your developers can integrate in minutes.</p><ul class="sms-feature-list"><li>Custom Sender ID for your brand</li><li>Real-time delivery &amp; balance tracking</li><li>Simple REST API integration</li></ul><div class="d-flex flex-wrap gap-3"><a href="tel:+94711111344" class="btn btn-primary btn-lg px-4">Call +94 71 111 1344 <span aria-hidden="true">&rarr;</span></a><a href="mailto:info@microplex.lk" class="btn btn-outline-light btn-lg px-4">Email us <span aria-hidden="true">&rarr;</span></a><button type="button" class="btn btn-outline-light btn-lg px-4" data-bs-toggle="modal" data-bs-target="#integrationModal" data-service="SMS Gateway">Integration <span aria-hidden="true">&rarr;</span></button></div></div><div class="col-lg-6"><div class="sms-visual" aria-hidden="true"><div class="sms-pulse-ring"></div><div class="sms-phone"><div class="sms-phone-notch"></div><span class="sms-sender-badge">DENIMS</span><div class="sms-bubble sms-bubble-1">Your order has shipped.</div><div class="sms-bubble sms-bubble-2">Delivered &#10003;</div><div class="sms-bubble sms-bubble-3">Thanks for shopping with us.</div></div></div></div></div></div></div></section>

<section class="section-space pt-0"><div class="container"><div class="email-panel"><div class="row align-items-center g-5"><div class="col-lg-6 order-lg-2"><span class="section-kicker">EMAIL GATEWAY</span><h2>Reach every inbox,<br />reliably.</h2><p>Send transactional and marketing email at scale through our reliable gateway&mdash;complete with your own sender domain, real-time delivery tracking, and a simple REST API your developers can integrate in minutes.</p><ul class="email-feature-list"><li>Custom sender domain &amp; reply-to address</li><li>Real-time delivery &amp; open tracking</li><li>Simple REST API integration</li></ul><div class="d-flex flex-wrap gap-3"><a href="tel:+94711111344" class="btn btn-primary btn-lg px-4">Call +94 71 111 1344 <span aria-hidden="true">&rarr;</span></a><a href="mailto:info@microplex.lk" class="btn btn-outline-light btn-lg px-4">Email us <span aria-hidden="true">&rarr;</span></a><button type="button" class="btn btn-outline-light btn-lg px-4" data-bs-toggle="modal" data-bs-target="#integrationModal" data-service="Email Gateway">Integration <span aria-hidden="true">&rarr;</span></button></div></div><div class="col-lg-6 order-lg-1"><div class="email-visual" aria-hidden="true"><div class="email-pulse-ring"></div><div class="email-inbox"><div class="email-inbox-header"><span></span><span></span><span></span></div><div class="email-card email-card-1"><span class="email-icon">&#9993;</span><div><strong>Invoice #10452</strong><small>Payment received</small></div></div><div class="email-card email-card-2"><span class="email-icon">&#9993;</span><div><strong>Order confirmed</strong><small>Thanks for your purchase</small></div></div><div class="email-card email-card-3"><span class="email-icon">&#9993;</span><div><strong>Monthly statement</strong><small>Your report is ready</small></div></div></div></div></div></div></div></div></section>

<section class="cta-section"><div class="container"><div class="row align-items-center gy-4"><div class="col-lg-8"><span class="section-kicker">YOUR NEXT SYSTEM STARTS HERE</span><h2>Let&rsquo;s build something that works brilliantly.</h2></div><div class="col-lg-4 text-lg-end"><a class="btn btn-light btn-lg px-4" asp-action="Contact">Contact Microplex <span>&rarr;</span></a></div></div></div></section>

<div class="modal fade" id="integrationModal" tabindex="-1" aria-labelledby="integrationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form asp-controller="Inquiry" asp-action="Submit" method="post">
        <input type="hidden" name="Service" id="integrationServiceInput" value="" />
        <input type="hidden" name="ReturnUrl" value="@Context.Request.Path" />
        <div class="modal-header">
          <h5 class="modal-title" id="integrationModalLabel">Get integration details</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p id="integrationModalCopy" class="mb-3"></p>
          <label for="integrationEmailInput" class="form-label">Your email address</label>
          <input type="email" name="Email" id="integrationEmailInput" class="form-control" placeholder="you@company.com" required />
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Send</button>
        </div>
      </form>
    </div>
  </div>
</div>
@section Scripts {
<script>
    (function () {
        var modalEl = document.getElementById("integrationModal");
        if (!modalEl) return;
        modalEl.addEventListener("show.bs.modal", function (event) {
            var trigger = event.relatedTarget;
            var service = trigger ? trigger.getAttribute("data-service") : "";
            document.getElementById("integrationServiceInput").value = service || "";
            document.getElementById("integrationModalCopy").textContent = "Enter your email and we'll send you the " + service + " integration details.";
        });
    })();
</script>
}
